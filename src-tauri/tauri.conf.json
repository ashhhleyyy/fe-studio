{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BAPS Presenter",
  "version": "0.2.0",
  "identifier": "uk.org.ury.fe-studio",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BAPS Presenter",
        "width": 1400,
        "height": 800,
        "minWidth": 100,
        "minHeight": 100
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
